rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Checks if user has admin or manager role
    function isManager() {
      return request.auth != null && (request.auth.token.role == 'manager' || request.auth.token.role == 'Manager');
    }
    function isAdminOrManager() {
      return request.auth != null && (
        request.auth.token.role == 'manager' || 
        request.auth.token.role == 'Manager' || 
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'Admin'
      );
    }

    // Core data: transmitters
    match /transmitters/{doc} {
      allow read, write: if request.auth != null;
    }

    // Core data: birds, positions, alerts
    match /positions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /birds/{doc} {
      allow read, write: if request.auth != null;
    }
    match /alerts/{doc} {
      allow read, write: if request.auth != null;
    }

    // Argos positions & telemetry data
    match /argos_positions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /argos_raw/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // Server-side pipeline (Admin SDK) only
    }
    match /argos_data/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // Server-side pipeline (Admin SDK) only
    }

    // Watermarks, health, and errors (Server-side pipeline only)
    match /sync_watermarks/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /system_health/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /ingest_errors/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isManager();
    }

    // Report Books (Multi-bird report collections)
    match /users/{uid}/reportBooks/{bookId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /pages/{pageId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Settings (CLS API, filters, system configurations)
    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdminOrManager();
    }

    // GEE and API configuration keys
    match /keys/{doc} {
      allow read, write: if request.auth != null;
    }

    // Support tickets
    match /support_tickets/{doc} {
      allow read, write: if request.auth != null;
    }

    // User Activity Logs
    match /user_activity_logs/{doc} {
      allow read, write: if request.auth != null;
    }

    // System status & ingestion metadata
    match /system_status/{doc} {
      allow read, write: if request.auth != null;
    }

    // Ingestion run audit logs
    match /ingest_runs/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdminOrManager();
    }

    // Security Audit Log — Written only via Cloud Functions (Admin SDK), never editable/deletable by client
    match /audit_log/{doc} {
      allow read: if request.auth != null;
      allow write, delete: if false;
    }
  }
}
