rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Core data — all authenticated users can read/write
    match /positions/{doc} {
      allow read, write: if request.auth != null;
    }
    match /transmitters/{doc} {
      allow read, write: if request.auth != null;
    }
    match /birds/{doc} {
      allow read, write: if request.auth != null;
    }
    match /alerts/{doc} {
      allow read, write: if request.auth != null;
    }
    // Argos positions — the Firebase-first data store
    match /argos_positions/{doc} {
      allow read, write: if request.auth != null;
    }
    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // GEE and API configuration keys
    match /keys/{doc} {
      allow read, write: if request.auth != null;
    }
    // Support tickets
    match /support_tickets/{doc} {
      allow read, write: if request.auth != null;
    }
    // User Activity Logs
    match /user_activity_logs/{doc} {
      allow read, write: if request.auth != null;
    }
    // System status & ingestion metadata
    match /system_status/{doc} {
      allow read, write: if request.auth != null;
    }
    // Ingestion run audit logs
    match /ingest_runs/{doc} {
      allow read, write: if request.auth != null;
    }
    // Security Audit Log — Written only via Cloud Functions (Admin SDK), never editable/deletable by client
    match /audit_log/{doc} {
      allow read: if request.auth != null;
      allow write, delete: if false;
    }
  }
}
